    "express-rate-limit": "^7.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.4",
    "joi": "^17.12.2",
    "dotenv": "^16.4.5",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "pdfkit": "^0.14.0",
    "exceljs": "^4.4.0",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "express-async-errors": "^3.1.1"
