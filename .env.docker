# ─── MongoDB ──────────────────────────────────────────
MONGO_USER=admin
MONGO_PASS=changeme_strong_password

# ─── JWT (generate with: openssl rand -hex 64) ────────
JWT_SECRET=replace_with_64_char_random_hex_string
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex

# ─── Mongo Express UI (dev only) ──────────────────────
ME_USER=admin
ME_PASS=adminpass

# ─── Company Info (printed on invoices) ───────────────
COMPANY_NAME=Your Company Name Pvt. Ltd.
COMPANY_GSTIN=27XXXXX0000X0XX
COMPANY_PHONE=+91 98765 43210
COMPANY_EMAIL=billing@yourcompany.com
COMPANY_ADDRESS=Your Address Here
COMPANY_STATE=Maharashtra
COMPANY_STATE_CODE=27

# ─── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com
