# ─── API ──────────────────────────────────────────────
# Development (Vite proxy handles /api → localhost:5000)
VITE_API_URL=/api

# Production — point to your deployed backend
# VITE_API_URL=https://billflow-api.render.com/api

# ─── App ──────────────────────────────────────────────
VITE_APP_NAME=BillFlow
VITE_APP_VERSION=2.4.1

# ─── Company Defaults (shown in invoices) ─────────────
VITE_COMPANY_NAME=Your Company Name
VITE_COMPANY_GSTIN=27XXXXX0000X0XX
VITE_COMPANY_STATE=Maharashtra
VITE_COMPANY_STATE_CODE=27

# ─── Feature Flags ────────────────────────────────────
VITE_ENABLE_BARCODE=true
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_EXPORT=true
